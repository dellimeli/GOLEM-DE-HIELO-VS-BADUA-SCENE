[sub_resource type="GDScript" id="GDScript_bl13t"]
resource_name = "test"
script/source = "extends Node2D

const furia: PackedScene = preload('res://scenes/furia.tscn')
var furioso: Area2D

var timer: float = 0.0



func _process(delta: float) -> void:
	
	if furioso != null: return
	
	timer += delta
	
	if timer >= 4.0:
		furioso = furia.instantiate()
		furioso.global_position = Vector2(576, 552)
		add_child.call_deferred(furioso)
		timer = 0.0
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_74lek"]
size = Vector2(15171, 62)

[sub_resource type="GDScript" id="GDScript_iyx0m"]
script/source = "extends Disco


func _ready() -> void:
	
	while global.golem == null:
		await get_tree().process_frame 
	
	while global.golem.estado != global.golem.estados.muerto:
		
		
		if global.golem.funcionar:
			_tirar_a_golem(900)
		
		await get_tree().create_timer(1.0).timeout
"

